PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/ticketing_platform
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d
SESSION_SECRET=replace_this_with_a_session_secret
SESSION_COOKIE_NAME=stagepass.sid

# Stripe (test mode keys)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# Cloudinary (for image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email (Nodemailer — Gmail App Password or SMTP provider)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM="StagePass <your_email@gmail.com>"

# Frontend URL (for Stripe redirect)
FRONTEND_URL=http://localhost:5173
# Comma-separated allowed browser origins. In production include your Vercel/custom frontend URL.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Enable this in exactly one backend instance (worker) so holds/reminders are processed once.
ENABLE_BOOKING_SCHEDULER=false
